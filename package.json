{
  "name": "opencode-kiro-auth",
  "version": "2.1.1",
  "description": "OpenCode plugin for AWS Kiro (CodeWhisperer)",
  "type": "module",
  "main": "./index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "compile": "tsc -p tsconfig.build.json && node scripts/fix-esm-imports.mjs",
    "format": "biome check --write .",
    "lint": "biome ci .",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opencode",
    "plugin",
    "kiro",
    "codewhisperer",
    "aws",
    "claude",
    "ai",
    "auth"
  ],
  "author": "tickernelz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jtdelia/opencode-kiro-auth.git"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.41",
    "@aws/codewhisperer-streaming-client": "^1.0.34",
    "@opencode-ai/plugin": "^1.15.11",
    "libsql": "^0.5.29",
    "proper-lockfile": "^4.1.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^20.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "bun-types": "^1.3.6",
    "typescript": "^5.7.3"
  },
  "opencode": {
    "type": "plugin",
    "hooks": [
      "auth",
      "event"
    ]
  },
  "files": [
    "index.ts",
    "src",
    "!src/__tests__",
    "README.md"
  ]
}
